{
  "name": "dsh-flowmeter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live model output speed (tok/s), a recent-speed bar chart, and time to first token, shown in the composer footer row.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PilotPhil/dsh-flowmeter.git"
  },
  "homepage": "https://github.com/PilotPhil/dsh-flowmeter#readme",
  "bugs": {
    "url": "https://github.com/PilotPhil/dsh-flowmeter/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tps",
    "ttft",
    "throughput",
    "composer"
  ],
  "license": "MIT"
}
