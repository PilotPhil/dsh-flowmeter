{
  "name": "dsh-flowmeter",
  "version": "1.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "Live model output speed (tok/s) with a recent-speed chart and time to first token in the composer footer, plus an all-sessions total/average meter in the sidebar foot.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PilotPhil/dsh-flowmeter.git"
  },
  "homepage": "https://github.com/PilotPhil/dsh-flowmeter#readme",
  "bugs": {
    "url": "https://github.com/PilotPhil/dsh-flowmeter/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tps",
    "ttft",
    "throughput",
    "sidebar",
    "composer"
  ],
  "license": "MIT"
}
